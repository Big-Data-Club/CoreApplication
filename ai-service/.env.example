# ==========================================
# FastAPI AI Service Local Configuration
# ==========================================
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration (Chỉ cần cho AI DB)
AI_DB_HOST=localhost
AI_DB_PORT=5432
AI_DB_USER=ai_user
AI_DB_PASSWORD=your_local_postgres_password
AI_DB_NAME=ai_db

# Qdrant Vector Store
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=true

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_local_neo4j_password

# Redis (Dùng cho cache status công việc)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_local_redis_password

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_admin_password
MINIO_BUCKET=lms-files

# LLM & Embedding models
GROQ_API_KEY=gsk_your_groq_api_key
# Optional; normally add/rotate this through /lms/admin/llm-config instead.
OPENAI_API_KEY=sk_your_openai_api_key
CHAT_MODEL=openai/gpt-oss-120b
QUIZ_MODEL=openai/gpt-oss-120b
LLM_REQUEST_TOKEN_BUDGET=10000
EMBEDDING_MODEL=BAAI/bge-m3

# Internal security
AI_SERVICE_SECRET=ai-service-secret-change-me
LMS_SERVICE_URL=http://localhost:8081

# ── MCP Server ────────────────────────────────────────────────────────────────
# Enable the MCP server at /mcp (off by default, opt-in).
MCP_ENABLED=false

# Comma-separated "api_key:user_id" pairs.
# Generate keys with: python -c "import secrets; print('bdc_mcp_' + secrets.token_hex(16))"
# Example: MCP_API_KEYS=bdc_mcp_abc123:42,bdc_mcp_xyz987:7
MCP_API_KEYS=

# Max requests per API key per minute (0 = unlimited, not recommended).
MCP_RATE_LIMIT_RPM=100

# Comma-separated tool names to expose (empty = all tools).
# Empty uses the safe built-in allowlist; it never exposes every agent tool.
MCP_ALLOWED_TOOLS=list_accessible_courses,list_my_courses,list_knowledge_nodes,search_course_materials,create_course_section,mcp_index_files,mcp_create_course_from_files,mcp_batch_generate_quiz,mcp_generate_slide_deck,mcp_generate_report,mcp_create_lesson
MCP_MAX_BODY_BYTES=1048576
MCP_MAX_BATCH_SIZE=20
MCP_TOOL_TIMEOUT_SECONDS=120
