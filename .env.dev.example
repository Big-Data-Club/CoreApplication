# Biến môi trường cho docker-compose.dev.yml
#
# Lọc từ 120 biến của .env.example xuống còn những biến mà 7 service trong
# compose tối giản thực sự đọc. Toàn bộ giá trị dưới đây là giá trị phát triển
# cục bộ, KHÔNG dùng cho máy chủ thật.
#
# Chạy:  docker compose -f docker-compose.dev.yml --env-file .env.dev up -d

# ── CSDL auth-service ────────────────────────────────────────────────────────
POSTGRES_DB=auth_db
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=dev_auth_pass
POSTGRES_PORT=5433

# ── CSDL lms-service ─────────────────────────────────────────────────────────
LMS_POSTGRES_DB=lms_db
LMS_POSTGRES_USER=lms_user
LMS_POSTGRES_PASSWORD=dev_lms_pass
LMS_POSTGRES_PORT=5434

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=dev_redis_pass
REDIS_PORT=6379

# ── MinIO, thay cho S3 ───────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
STORAGE_TYPE=minio

# ── Cổng dịch vụ ─────────────────────────────────────────────────────────────
BACKEND_PORT=8080
LMS_PORT=8081

# ── Bí mật dùng chung ────────────────────────────────────────────────────────
# JWT_SECRET phải giống nhau ở auth-service và lms-service, vì lms tự xác thực
# token do auth phát hành. Đổi một bên là mọi request tới lms trả 401.
JWT_SECRET=dev-jwt-secret-doi-truoc-khi-len-may-chu-that-toi-thieu-32-ky-tu
JWT_EXPIRATION_MS=3600000
# Bí mật để auth-service gọi các endpoint /api/v1/sync/* của lms-service.
# Compose truyền biến này cho cả hai bên nên không cần khai hai giá trị.
LMS_SYNC_SECRET=dev-lms-sync-secret

# Bắt buộc phải có dù không chạy ai-service: application.yaml của auth-service khai
# ${AI_SERVICE_SECRET} không kèm giá trị mặc định, thiếu là Spring sập lúc khởi động.
AI_SERVICE_SECRET=dev-ai-service-secret

# Để trống thì đăng nhập bằng Google không hoạt động, các cách đăng nhập khác vẫn chạy.
GOOGLE_CLIENT_ID=

# ── Tài khoản quản trị tạo sẵn lúc khởi động ─────────────────────────────────
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=Admin@12345

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-nextauth-secret-doi-truoc-khi-len-may-chu-that
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Cấu hình chung ───────────────────────────────────────────────────────────
APP_ENV=development
SPRING_PROFILES_ACTIVE=docker
JPA_DDL_AUTO=update
LOG_LEVEL=INFO
APP_PUBLIC_URL=http://localhost:3000

# ── Email, để trống thì chức năng gửi mail không hoạt động ───────────────────
# Cần cho FR-AUTH-05 (khôi phục mật khẩu qua email). Điền sau khi có SMTP.
EMAIL=
EMAIL_PASSWORD=
