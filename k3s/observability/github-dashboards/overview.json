{
  "uid": "bdc-gh-overview",
  "title": "GitHub \u00b7 Overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "bdc",
    "github",
    "management"
  ],
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-5d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "Scope & definitions",
      "options": {
        "mode": "markdown",
        "content": "## Big-Data-Club \u00b7 Engineering pulse\nOrganization-wide, token-visible repositories. Open PRs include older backlog; merged PRs and updated issues follow the selected time window. Charts count returned records, not guaranteed complete organization totals. Refresh: 5 minutes."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "id": 1
    },
    {
      "type": "barchart",
      "title": "Open PRs by repository \u00b7 current",
      "datasource": {
        "type": "grafana-github-datasource",
        "uid": "bdc-github"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-github-datasource",
            "uid": "bdc-github"
          },
          "queryType": "Pull_Requests",
          "owner": "Big-Data-Club",
          "repository": "",
          "options": {
            "query": "is:open",
            "timeField": 4
          }
        }
      ],
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "repository": {
                "operation": "groupby",
                "aggregations": []
              },
              "number": {
                "operation": "aggregate",
                "aggregations": [
                  "count"
                ]
              }
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single"
        },
        "xField": "repository"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 12
      },
      "id": 2
    },
    {
      "type": "barchart",
      "title": "Merged PRs by repository \u00b7 selected window",
      "datasource": {
        "type": "grafana-github-datasource",
        "uid": "bdc-github"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-github-datasource",
            "uid": "bdc-github"
          },
          "queryType": "Pull_Requests",
          "owner": "Big-Data-Club",
          "repository": "",
          "options": {
            "query": "is:merged",
            "timeField": 2
          }
        }
      ],
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "repository": {
                "operation": "groupby",
                "aggregations": []
              },
              "number": {
                "operation": "aggregate",
                "aggregations": [
                  "count"
                ]
              }
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single"
        },
        "xField": "repository"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 12
      },
      "id": 3
    },
    {
      "type": "table",
      "title": "Open pull requests \u00b7 current",
      "datasource": {
        "type": "grafana-github-datasource",
        "uid": "bdc-github"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-github-datasource",
            "uid": "bdc-github"
          },
          "queryType": "Pull_Requests",
          "owner": "Big-Data-Club",
          "repository": "",
          "options": {
            "query": "is:open sort:created-asc",
            "timeField": 4
          }
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "repository",
                "number",
                "title",
                "author_login",
                "is_draft",
                "created_at",
                "url"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open GitHub",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 12
      },
      "id": 4
    },
    {
      "type": "table",
      "title": "Issues updated \u00b7 selected window",
      "datasource": {
        "type": "grafana-github-datasource",
        "uid": "bdc-github"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-github-datasource",
            "uid": "bdc-github"
          },
          "queryType": "Issues",
          "owner": "Big-Data-Club",
          "repository": "",
          "options": {
            "timeField": 2
          }
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "repo",
                "number",
                "title",
                "state",
                "updated_at"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 12
      },
      "id": 5
    }
  ],
  "links": [
    {
      "title": "Overview",
