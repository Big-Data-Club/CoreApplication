{
  "uid": "bdc-gh-repositories",
  "title": "GitHub \u00b7 Repositories",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "bdc",
    "github",
    "management"
  ],
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-5d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "Scope & definitions",
      "options": {
        "mode": "markdown",
        "content": "## Repository inventory\nRepositories visible to this credential, including forks and mirrors. Inventory is a current snapshot, independent of the time picker. This plugin schema does not expose archive state; no active-repository total is claimed."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "id": 1
    },
    {
      "type": "barchart",
      "title": "Repository visibility \u00b7 true = private",
      "datasource": {
        "type": "grafana-github-datasource",
        "uid": "bdc-github"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-github-datasource",
            "uid": "bdc-github"
          },
          "queryType": "Repositories",
          "owner": "Big-Data-Club",
          "repository": "",
          "options": {}
        }
      ],
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "is_private",
                "destinationType": "string"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "is_private": {
                "operation": "groupby",
                "aggregations": []
              },
              "name": {
                "operation": "aggregate",
                "aggregations": [
                  "count"
                ]
              }
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single"
        },
        "xField": "is_private"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 12
      },
      "id": 2
    },
    {
      "type": "barchart",
      "title": "Fork distribution",
      "datasource": {
        "type": "grafana-github-datasource",
        "uid": "bdc-github"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-github-datasource",
            "uid": "bdc-github"
          },
          "queryType": "Repositories",
          "owner": "Big-Data-Club",
          "repository": "",
          "options": {}
        }
      ],
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "is_fork",
                "destinationType": "string"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "is_fork": {
                "operation": "groupby",
                "aggregations": []
              },
              "name": {
                "operation": "aggregate",
                "aggregations": [
                  "count"
                ]
              }
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single"
        },
        "xField": "is_fork"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 12
      },
      "id": 3
    },
    {
      "type": "table",
      "title": "Repository inventory",
      "datasource": {
        "type": "grafana-github-datasource",
        "uid": "bdc-github"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-github-datasource",
            "uid": "bdc-github"
          },
          "queryType": "Repositories",
          "owner": "Big-Data-Club",
          "repository": "",
          "options": {}
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "name_with_owner",
                "is_private",
                "is_fork",
                "is_mirror",
                "forks",
                "created_at",
                "url"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open GitHub",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 12
      },
      "id": 4
    }
  ],
  "links": [
    {
